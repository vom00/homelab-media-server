# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your real values never get committed.

# Linux user and group IDs that own the media files.
# Run `id` on the server to find them.
PUID=<your_PUID>
PGID=<your_PGID>

# Time zone, for example America/Chicago
TZ=<your_timezone>

# Folder that holds your movies/ and tvshows/ folders.
MEDIA_DIRECTORY=<path_to_media>

# Folder where this repo lives on the server. App settings go in ./config inside it.
INSTALL_DIRECTORY=<path_to_this_repo>

# Which media server to run: jellyfin, emby or plex
MEDIA_SERVICE=jellyfin
